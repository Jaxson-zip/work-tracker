# 浏览器可见（VITE_ 开头的都会打包进前端，不要放密钥）
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# 以下只放在服务端，不要加 VITE_ 前缀，不要提交真实值
SUPABASE_SERVICE_ROLE_KEY=

# 每个团队对应一个群机器人。键是团队 ID（wt_workspaces.id），企业微信不需要 secret，飞书必须有。
# {"团队ID":{"url":"https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=替换成你的key"}}
# {"团队ID":{"url":"https://open.feishu.cn/open-apis/bot/v2/hook/替换成你的id","secret":"替换成签名密钥"}}
WORKSPACE_WEBHOOKS=

# Vercel Cron 调用 /api/notify/dispatch 时带的密钥，用足够长的随机串
CRON_SECRET=
# 附在群消息末尾的系统链接，例如 https://your-app.vercel.app
APP_BASE_URL=
# 每日摘要按这个时区、这个钟点之后生成
APP_TIMEZONE=Asia/Shanghai
DIGEST_HOUR=9
